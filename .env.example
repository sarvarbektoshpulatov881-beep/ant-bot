# Bu faylni .env nomi bilan nusxalang va qiymatlarni to'ldiring

# @BotFather bergan token
BOT_TOKEN=

# Sotuvchilar guruhi ID si (ixtiyoriy: bot egasi guruhda /guruh yozsa ham bo'ladi)
SELLERS_CHAT_ID=

# Qo'shimcha operatorlar ID si, vergul bilan (ixtiyoriy: odatda jamoa bot ichida 👥 Adminlar orqali boshqariladi)
OPERATOR_IDS=

# Tashrifdan necha daqiqa oldin eslatish (1440 = 1 kun, 60 = 1 soat, 30 = 30 daqiqa)
REMINDER_MINUTES=1440,60

# Har kuni bugungi tashriflar ro'yxati yuboriladigan vaqt
DAILY_SUMMARY_TIME=09:00

# Tashrif vaqtidan necha daqiqa o'tib "Mijoz keldimi?" eslatmasi
CHECK_AFTER_MINUTES=60

# Egasiga kunlik hisobot vaqti
REPORT_TIME=23:00

TIMEZONE=Asia/Tashkent
DB_PATH=ant_bot.db
