# Bu faylni .env nomi bilan nusxalang va qiymatlarni to'ldiring

# @BotFather bergan token
BOT_TOKEN=8656597114:AAEx7vO2EV8JsaEuxT73iJ9Uj6eC9TEkD_U

# Sotuvchilar guruhining ID si (guruhda /id yozib bilib olasiz, odatda -100... bilan boshlanadi)
SELLERS_CHAT_ID=

# Tashrif kirita oladigan operatorlar ID si, vergul bilan (bo'sh bo'lsa — hamma kirita oladi, faqat sinov uchun)
OPERATOR_IDS=

# Tashrifdan necha daqiqa oldin eslatish (1440 = 1 kun, 60 = 1 soat, 30 = 30 daqiqa)
REMINDER_MINUTES=1440,60

# Har kuni bugungi tashriflar ro'yxati yuboriladigan vaqt
DAILY_SUMMARY_TIME=09:00

TIMEZONE=Asia/Tashkent
DB_PATH=ant_bot.db
